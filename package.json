{
  "name": "bodega-ventas",
  "private": true,
  "description": "Sistema de ventas para bodega. Atajos para ejecutar los comandos del backend y del frontend desde la carpeta raíz.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm --prefix backend run start:dev",
    "start:dev": "npm --prefix backend run start:dev",
    "web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "test:web": "npm --prefix frontend run test:web",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:studio": "npm --prefix backend run db:studio",
    "prod:instalar": "docker compose -f produccion/docker-compose.yml up -d --build",
    "prod:estado": "docker compose -f produccion/docker-compose.yml ps",
    "prod:logs": "docker compose -f produccion/docker-compose.yml logs -f api",
    "prod:respaldar": "docker compose -f produccion/docker-compose.yml exec respaldos sh /respaldar.sh ahora"
  }
}
