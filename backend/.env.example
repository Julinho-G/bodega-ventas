# Copia este archivo como .env y ajusta los valores si lo necesitas
DATABASE_URL="postgresql://bodega:bodega123@localhost:5440/bodega_db?schema=public"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Clave para firmar los tokens de sesión (cámbiala por un texto largo y aleatorio)
JWT_SECRET="cambia-esto-por-un-secreto-largo"

# Duración del token en horas (opcional, por defecto 8 = un turno)
JWT_HORAS=8
