# Configuración de PRODUCCIÓN. Copia este archivo como "produccion/.env" y completa los valores.
# (En PowerShell:  copy .env.example .env)
# ¡No subas el .env a Git! (ya está en .gitignore)
#
# Para las claves usa SOLO letras y números (sin @ : / # ni espacios).
# En PowerShell puedes generar una clave aleatoria de 40 caracteres con:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 40 | ForEach-Object { [char]$_ })

# Contraseña de la base de datos (nadie la escribe a mano: la usan los contenedores)
DB_PASSWORD=

# Clave para firmar las sesiones: mínimo 32 caracteres
JWT_SECRET=

# Contraseña del usuario "admin". Se usa SOLO la primera vez, cuando la base está vacía.
# Mínimo 8 caracteres. Anótala en un lugar seguro.
ADMIN_PASSWORD=

# Nombre que aparece en las pantallas
NOMBRE_BODEGA="BODEGA D' CONSTANTINA"

# El sistema se abre en http://localhost:8080 (cambia el número si ese puerto está ocupado)
PUERTO=8080

# Horas que dura una sesión antes de pedir otra vez la contraseña
JWT_HORAS=12

# Carpeta donde se guardan las copias de seguridad diarias.
# Recomendado: una carpeta dentro de OneDrive, para tener copia fuera de la laptop. Ejemplo:
#   CARPETA_RESPALDOS=C:/Users/TU_USUARIO/OneDrive/Respaldos bodega
CARPETA_RESPALDOS=./respaldos

# Días que se guardan las copias (las más antiguas se borran solas)
DIAS_A_GUARDAR=30
